# Local infrastructure. Copy this file to .env before starting Compose.
POSTGRES_DB=hootly
POSTGRES_USER=hootly
POSTGRES_PASSWORD=change-me-before-sharing

MINIO_ROOT_USER=hootly-minio
MINIO_ROOT_PASSWORD=change-me-before-sharing

# Used by the service skeletons; Prisma will own this connection in Sprint 02.
DATABASE_URL=postgresql://hootly:change-me-before-sharing@postgres:5432/hootly
SOCIAL_SERVICE_URL=http://graph-api:8000
AI_SERVICE_URL=http://ai-service:8080
# RAG: cosine similarity threshold for the local multilingual E5 model.
# Calibrate against the evaluation dataset; similarity is not factual accuracy.
RAG_MIN_SIMILARITY=0.82
# Sprint 11 Jour 3 — le worker appelle Express pour créer/pousser une
# notification (Firebase Admin ne vit que côté API, voir plus bas).
API_SERVICE_URL=http://api:3000

# graph-api / Meta (see graph-api/.env.example) — Compose interpolates these
# from this root file, not from graph-api/.env, so they must be duplicated
# here for `/ready` to report true under `docker compose up`.
FACEBOOK_APP_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# OAuth (Sprint 06) — FACEBOOK_APP_SECRET is only used for the Meta code/token
# exchange, never sent anywhere else. SOCIAL_SERVICE_PUBLIC_URL is graph-api's
# OWN public base URL (must match a "Valid OAuth Redirect URI" registered in
# the Meta App) — `http://localhost:8000` works for local testing from the
# same machine (Meta allows localhost in development); use a real HTTPS
# domain in staging/production.
FACEBOOK_APP_SECRET=
SOCIAL_SERVICE_PUBLIC_URL=http://localhost:8000

# Instagram Login direct (Sprint 07) — a separate Meta API product from the
# Facebook app above (its own app in the Meta Developer dashboard). Only
# needed for the no-Page creator connection path; a Page-linked Instagram
# account reuses the Facebook credentials above.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Meta webhooks (Sprint 08) — hub.verify_token for the GET subscription
# challenge in the Meta App Dashboard's Webhooks page. Not a Meta-issued
# secret: pick any random string yourself, put the same value here and in
# the Dashboard. Distinct from FACEBOOK_APP_SECRET/INSTAGRAM_APP_SECRET,
# which sign the POST body instead and never need to be typed anywhere.
META_WEBHOOK_VERIFY_TOKEN=

# Sprint 07 — the worker delivers real publications via graph-api by
# default. Set to `mock` for a demo/staging environment with no real Meta
# accounts connected yet (uses services/shared/social-provider.js's
# deterministic [[FAIL_*]]/[[TIMEOUT]] connector instead).
SOCIAL_PROVIDER_MODE=live

# Development-only signing configuration. Replace with randomly generated
# secrets before using any shared or production environment.
JWT_ACCESS_SECRET=local-development-only-please-replace-with-a-random-64-character-secret
JWT_ISSUER=hootly-api
JWT_AUDIENCE=hootly-mobile
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Shared secret for the service-to-service JWTs Express/worker mint to call
# graph-api's and ai-service's /internal/v1 (Sprints 05 and 09). Distinct from
# JWT_ACCESS_SECRET: a mobile/user token must never be accepted on an internal
# route. The same secret signs both, but each service checks its own audience
# ("social-service" / "ai-service"), so a token minted to publish on Meta
# cannot be replayed against the analysis service.
SERVICE_JWT_SECRET=local-development-only-please-replace-with-a-random-64-character-secret

# Meta tokens at rest (Sprint 06) — graph-api only. Base64 of exactly 32
# random bytes; regenerate with `openssl rand -base64 32` before using any
# shared or production environment. Add _2, _3... and bump CURRENT_VERSION
# to rotate without touching already-encrypted rows.
TOKEN_ENCRYPTION_KEY_CURRENT_VERSION=1
TOKEN_ENCRYPTION_KEY_1=j2ubBqc55SEMN/9pQTRCTEtpIlkyFS/jMTrolUicdiM=

# Génération de réponses (Sprint 10). `local` : générateur déterministe piloté
# par les paramètres de marque — aucune clé, aucun appel réseau, la démo et les
# tests fonctionnent hors ligne. `llm` : passe par Claude quand
# ANTHROPIC_API_KEY est renseignée, et retombe automatiquement sur le
# générateur local si le modèle est indisponible (voir
# services/ai-service/modules/generation/provider.py). La clé reste
# côté serveur : le mobile ne l'atteint jamais.
AI_GENERATION_MODE=local
ANTHROPIC_API_KEY=

# Firebase Cloud Messaging (Sprint 11) — canal de livraison push, jamais la
# source de vérité (REST + base le restent). Les trois valeurs viennent de la
# clé de compte de service téléchargée depuis la console Firebase (Paramètres
# du projet > Comptes de service > Générer une nouvelle clé privée, un fichier
# JSON) : `project_id` → FIREBASE_PROJECT_ID, `client_email` →
# FIREBASE_CLIENT_EMAIL, `private_key` → FIREBASE_PRIVATE_KEY. Ce fichier JSON
# ne doit JAMAIS être committé, y compris dans un sous-dossier ; seules ces
# trois valeurs, extraites à la main, vivent dans ce .env local (ignoré par
# Git). La clé privée du JSON contient de vrais retours à la ligne : collée
# ici sur une seule ligne, ils doivent être remplacés par des `\n` littéraux
# (lib/firebase.js les réinterprète au chargement). Tant que ces trois
# variables ne sont pas renseignées, /api/v1 fonctionne normalement — seul
# l'envoi push est silencieusement désactivé (voir NotificationPushService).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stockage média (Sprint 04). En local, MinIO joue le rôle de S3.
# `S3_PUBLIC_ENDPOINT` est l'hôte utilisé pour signer les URL rendues au
# téléphone : « localhost » sur simulateur iOS et web, « 10.0.2.2 » sur
# l'émulateur Android, l'IP LAN de la machine sur un appareil physique.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
MEDIA_BUCKET=hootly
MEDIA_MAX_BYTES=8000000
MEDIA_URL_TTL_SECONDS=900
