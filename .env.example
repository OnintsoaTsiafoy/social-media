# Local infrastructure. Copy this file to .env before starting Compose.
POSTGRES_DB=hootly
POSTGRES_USER=hootly
POSTGRES_PASSWORD=change-me-before-sharing

MINIO_ROOT_USER=hootly-minio
MINIO_ROOT_PASSWORD=change-me-before-sharing

# Used by the service skeletons; Prisma will own this connection in Sprint 02.
DATABASE_URL=postgresql://hootly:change-me-before-sharing@postgres:5432/hootly
SOCIAL_SERVICE_URL=http://graph-api:8000
AI_SERVICE_URL=http://ai-service:8080

# Development-only signing configuration. Replace with randomly generated
# secrets before using any shared or production environment.
JWT_ACCESS_SECRET=local-development-only-please-replace-with-a-random-64-character-secret
JWT_ISSUER=hootly-api
JWT_AUDIENCE=hootly-mobile
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Stockage média (Sprint 04). En local, MinIO joue le rôle de S3.
# `S3_PUBLIC_ENDPOINT` est l'hôte utilisé pour signer les URL rendues au
# téléphone : « localhost » sur simulateur iOS et web, « 10.0.2.2 » sur
# l'émulateur Android, l'IP LAN de la machine sur un appareil physique.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
MEDIA_BUCKET=hootly
MEDIA_MAX_BYTES=8000000
MEDIA_URL_TTL_SECONDS=900
