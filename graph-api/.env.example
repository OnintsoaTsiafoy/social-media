# Facebook
# Optional for local health checks. Required before calling Facebook routes.
FACEBOOK_APP_ID=your_app_id
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token
# OAuth (Sprint 06) — only used for the Meta code/token exchange.
FACEBOOK_APP_SECRET=your_app_secret

# Instagram Login direct (Sprint 07) — a separate Meta API product/app from
# Facebook above. Only needed for the no-Page creator connection path; a
# Page-linked Instagram account reuses the Facebook credentials above.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Meta webhooks (Sprint 08) — hub.verify_token for the GET subscription
# challenge. Not Meta-issued: pick any random string, same value in the App
# Dashboard's Webhooks page and here. GET/POST /webhooks/meta.
META_WEBHOOK_VERIFY_TOKEN=

# This service's own public base URL, registered with Meta as a "Valid OAuth
# Redirect URI" (as `{PUBLIC_BASE_URL}/oauth/facebook/callback`).
# http://localhost:8000 works for local testing from the same machine.
PUBLIC_BASE_URL=http://localhost:8000

# Graph API
GRAPH_API_BASE_URL=https://graph.facebook.com/v25.0

# Service JWT for /internal/v1 (Sprint 05) — same value as the repo-root
# SERVICE_JWT_SECRET given to Express/worker under Compose.
SERVICE_JWT_SECRET=local-development-only-please-replace-with-a-random-64-character-secret

# Left empty: /internal/v1 is server-to-server, /oauth/*/callback is a
# top-level browser navigation — neither needs CORS in practice.
CORS_ALLOWED_ORIGINS=

# Sprint 06 — social_accounts/oauth_tokens/social_permissions/oauth_states/
# service_idempotency_keys (raw SQL; Prisma still owns the migration). Same
# Postgres as services/api, e.g. postgresql://hootly:...@localhost:5432/hootly
# when running graph-api outside Compose.
DATABASE_URL=

# Meta tokens at rest — base64 of exactly 32 random bytes
# (`openssl rand -base64 32`). Same value as the repo-root .env under Compose.
TOKEN_ENCRYPTION_KEY_CURRENT_VERSION=1
TOKEN_ENCRYPTION_KEY_1=
