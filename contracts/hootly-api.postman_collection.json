{
  "info": {
    "name": "Hootly API - Sprint 04 (publications, médias, scheduler)",
    "description": "Requêtes de vérification du Sprint 04. Lancez « Connexion » puis « Marques » : les variables accessToken et brandId sont renseignées automatiquement.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Session",
      "item": [
        {
          "name": "Connexion (renseigne accessToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "accept",
                "value": "application/json"
              },
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Le script de test enregistre les jetons dans les variables de la collection.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lea@studio-vega.fr\",\n  \"password\": \"ChangeMe123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('accessToken', data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', data.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Marques (renseigne brandId)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "accept",
                "value": "application/json"
              },
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/brands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "brands"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const items = pm.response.json().data.items;",
                  "if (items.length) pm.collectionVariables.set('brandId', items[0].id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Médias",
      "item": [
        {
          "name": "Déposer un média",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "accept",
                "value": "application/json"
              },
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/media",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "media"
              ]
            },
            "description": "Le type réel est déduit des octets : renommer un fichier ne suffit pas.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Image JPEG, PNG ou WebP (8 Mo max, 320 px min)"
                },
                {
                  "key": "brandId",
                  "value": "{{brandId}}",
                  "type": "text"
                },
                {
                  "key": "purpose",
                  "value": "publication",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('mediaId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Métadonnées et URL signée",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "accept",
                "value": "application/json"
              },
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/media/{{mediaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "media",
                "{{mediaId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Supprimer un média",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "accept",
                "value": "application/json"
              },
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/media/{{mediaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "media",
                "{{mediaId}}"
              ]
            },
            "description": "409 media_in_use si le média est rattaché à une publication."
          }
        }
      ]
    },
    {
