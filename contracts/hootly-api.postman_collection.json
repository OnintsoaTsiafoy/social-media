            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brandId\": \"{{brandId}}\",\n  \"content\": \"Nouvelle collection automne\",\n  \"language\": \"fr\",\n  \"hashtags\": [\n    \"#automne\",\n    \"#collection\"\n  ],\n  \"mediaIds\": [],\n  \"targets\": [\n    {\n      \"provider\": \"facebook\"\n    },\n    {\n      \"provider\": \"instagram\",\n      \"adaptedContent\": \"Version Instagram\",\n      \"adaptedHashtags\": [\n        \"#reels\"\n      ]\n    }\n  ],\n  \"timezone\": \"Europe/Paris\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('publicationId', pm.response.json().data.id);"
                ]
