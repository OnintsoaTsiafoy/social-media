generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum BrandMemberRole {
  OWNER
  ADMIN
  COMMUNITY_MANAGER
  VIEWER
}

enum BrandStatus {
  ACTIVE
  ARCHIVED
}

enum AiTone {
  PROFESSIONAL
  FRIENDLY
  EMPATHETIC
  FORMAL
  CUSTOM
}

enum PublicationStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  CANCELLED
}

enum PublicationTargetStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum DeliveryAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum SocialProvider {
  FACEBOOK
  INSTAGRAM
}

enum ScheduleStatus {
  PENDING
  DISPATCHED
  CANCELLED
}

enum AiFormality {
  INFORMAL
  FORMAL
  ADAPTIVE
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(320)
  passwordHash        String               @map("password_hash")
  firstName           String               @map("first_name") @db.VarChar(80)
  lastName            String               @map("last_name") @db.VarChar(80)
  displayName         String               @map("display_name") @db.VarChar(100)
  language            String               @default("fr") @db.VarChar(8)
  timezone            String               @default("Europe/Paris") @db.VarChar(64)
  phone               String?              @db.VarChar(30)
  preferences         Json                 @default("{}")
  avatarMediaId       String?              @unique @map("avatar_media_id") @db.Uuid
  status              UserStatus           @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  memberships         BrandMember[]
  ownedBrands         Brand[]              @relation("BrandOwner")
  aiSettingsCreated   BrandAiSetting[]     @relation("AiSettingsAuthor")
  uploadedMedia       Media[]              @relation("MediaOwner")
  publications        Publication[]        @relation("PublicationAuthor")
  schedules           ScheduledPublication[] @relation("ScheduleAuthor")
  avatarMedia         Media?               @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("users")
}

model Brand {
  id              String         @id @default(uuid()) @db.Uuid
  ownerUserId     String         @map("owner_user_id") @db.Uuid
  name            String         @db.VarChar(120)
  description     String?        @db.Text
  industry        String?        @db.VarChar(100)
  primaryLanguage String         @default("fr") @map("primary_language") @db.VarChar(8)
  status          BrandStatus    @default(ACTIVE)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner           User           @relation("BrandOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members         BrandMember[]
  aiSettings      BrandAiSetting[]
  media           Media[]
  publications    Publication[]

  @@index([ownerUserId])
  @@index([deletedAt])
  @@map("brands")
}

model BrandMember {
  id        String          @id @default(uuid()) @db.Uuid
  brandId   String          @map("brand_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  role      BrandMemberRole @default(VIEWER)
  isActive  Boolean         @default(false) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  brand     Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([brandId, userId])
  @@index([userId, isActive])
  @@index([brandId, role])
  @@map("brand_members")
}

model BrandAiSetting {
  id                  String      @id @default(uuid()) @db.Uuid
  brandId             String      @map("brand_id") @db.Uuid
  version             Int
  tone                AiTone      @default(PROFESSIONAL)
  customTone          String?     @map("custom_tone") @db.Text
  formality           AiFormality @default(ADAPTIVE)
  language            String      @default("fr") @db.VarChar(8)
  emojisAllowed       Boolean     @default(true) @map("emojis_allowed")
  targetLength        String      @default("2 phrases") @map("target_length") @db.VarChar(32)
  greeting            String?     @db.VarChar(300)
  closing             String?     @db.VarChar(300)
  forbiddenTerms      Json        @default("[]") @map("forbidden_terms")
  recommendedTerms    Json        @default("[]") @map("recommended_terms")
  instructions        String?     @db.Text
  complaintInstructions String?   @map("complaint_instructions") @db.Text
  urgencyInstructions String?     @map("urgency_instructions") @db.Text
  supportInstructions String?     @map("support_instructions") @db.Text
  createdByUserId     String      @map("created_by_user_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  brand               Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdByUser       User        @relation("AiSettingsAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([brandId, version])
  @@index([brandId, createdAt])
  @@map("brand_ai_settings")
}

model Media {
  id          String    @id @default(uuid()) @db.Uuid
  ownerUserId String?   @map("owner_user_id") @db.Uuid
  brandId     String?   @map("brand_id") @db.Uuid
  bucket      String    @default("hootly") @db.VarChar(100)
  objectKey   String    @unique @map("object_key") @db.VarChar(1024)
  mimeType    String    @map("mime_type") @db.VarChar(127)
  sizeBytes   Int       @map("size_bytes")
  width       Int?
  height      Int?
  status      String    @default("READY") @db.VarChar(32)
  purpose     String    @default("publication") @db.VarChar(32)
  checksum    String?   @db.VarChar(128)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  owner       User?     @relation("MediaOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  brand       Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  avatarFor   User?     @relation("UserAvatar")
  publications PublicationMedia[]

  @@index([ownerUserId, createdAt])
  @@index([brandId, createdAt])
  @@map("media")
}

model UserSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  refreshTokenHash    String    @map("refresh_token_hash")
  deviceName          String    @default("Unknown device") @map("device_name") @db.VarChar(255)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt          DateTime? @map("last_used_at") @db.Timestamptz(6)
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String   @db.VarChar(120)
  resourceType String   @map("resource_type") @db.VarChar(80)
  resourceId   String?  @map("resource_id") @db.VarChar(255)
  requestId    String?  @map("request_id") @db.VarChar(100)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model Publication {
  id              String                @id @default(uuid()) @db.Uuid
  brandId         String                @map("brand_id") @db.Uuid
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  content         String                @db.Text
  language        String                @default("fr") @db.VarChar(8)
  hashtags        Json                  @default("[]")
  status          PublicationStatus     @default(DRAFT)
  scheduledAt     DateTime?             @map("scheduled_at") @db.Timestamptz(6)
  timezone        String                @default("Europe/Paris") @db.VarChar(64)
  publishedAt     DateTime?             @map("published_at") @db.Timestamptz(6)
  deletedAt       DateTime?             @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  brand           Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy       User                  @relation("PublicationAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  targets         PublicationTarget[]
  media           PublicationMedia[]
  schedule        ScheduledPublication?

  @@index([brandId, status])
  @@index([brandId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([deletedAt])
  @@map("publications")
}

model PublicationTarget {
  id                    String                       @id @default(uuid()) @db.Uuid
  publicationId         String                       @map("publication_id") @db.Uuid
  // Renseigné au Sprint 06, quand les comptes sociaux liés par OAuth existeront.
  // La contrainte de clé étrangère sera ajoutée avec la table `social_accounts`.
  socialAccountId       String?                      @map("social_account_id") @db.Uuid
  provider              SocialProvider
  adaptedContent        String?                      @map("adapted_content") @db.Text
  adaptedHashtags       Json                         @default("[]") @map("adapted_hashtags")
  status                PublicationTargetStatus      @default(PENDING)
  externalPublicationId String?                      @map("external_publication_id") @db.VarChar(255)
  lastErrorCode         String?                      @map("last_error_code") @db.VarChar(80)
  lastErrorMessage      String?                      @map("last_error_message") @db.Text
  attemptCount          Int                          @default(0) @map("attempt_count")
  sentAt                DateTime?                    @map("sent_at") @db.Timestamptz(6)
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  publication           Publication                  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  attempts              PublicationDeliveryAttempt[]

  @@unique([publicationId, provider])
  @@index([status])
  @@map("publication_targets")
}

model PublicationMedia {
  id            String      @id @default(uuid()) @db.Uuid
  publicationId String      @map("publication_id") @db.Uuid
  mediaId       String      @map("media_id") @db.Uuid
  position      Int         @default(0)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  media         Media       @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([publicationId, mediaId])
  @@unique([publicationId, position])
  @@index([mediaId])
  @@map("publication_media")
}

model ScheduledPublication {
  id              String         @id @default(uuid()) @db.Uuid
  publicationId   String         @unique @map("publication_id") @db.Uuid
  scheduledAt     DateTime       @map("scheduled_at") @db.Timestamptz(6)
  timezone        String         @default("Europe/Paris") @db.VarChar(64)
  jobId           String?        @map("job_id") @db.VarChar(64)
  status          ScheduleStatus @default(PENDING)
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  publication     Publication    @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  createdBy       User           @relation("ScheduleAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([status, scheduledAt])
  @@map("scheduled_publications")
}

model PublicationDeliveryAttempt {
  id                    String                @id @default(uuid()) @db.Uuid
  publicationTargetId   String                @map("publication_target_id") @db.Uuid
  attemptNumber         Int                   @map("attempt_number")
  // Empêche qu'une même tentative parte deux fois, même si le job est rejoué.
  idempotencyKey        String                @unique @map("idempotency_key") @db.VarChar(200)
  status                DeliveryAttemptStatus @default(STARTED)
  errorCode             String?               @map("error_code") @db.VarChar(80)
  errorMessage          String?               @map("error_message") @db.Text
  externalPublicationId String?               @map("external_publication_id") @db.VarChar(255)
  startedAt             DateTime              @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt            DateTime?             @map("finished_at") @db.Timestamptz(6)
  target                PublicationTarget     @relation(fields: [publicationTargetId], references: [id], onDelete: Cascade)

  @@unique([publicationTargetId, attemptNumber], map: "publication_delivery_attempts_target_attempt_key")
  @@index([status, startedAt])
  @@map("publication_delivery_attempts")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @db.VarChar(200)
  endpoint       String   @db.VarChar(120)
  userId         String   @map("user_id") @db.Uuid
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  resourceId     String?  @map("resource_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
