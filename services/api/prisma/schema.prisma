generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum BrandMemberRole {
  OWNER
  ADMIN
  COMMUNITY_MANAGER
  VIEWER
}

enum BrandStatus {
  ACTIVE
  ARCHIVED
}

enum AiTone {
  PROFESSIONAL
  FRIENDLY
  EMPATHETIC
  FORMAL
  CUSTOM
}

enum PublicationStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  CANCELLED
}

enum PublicationTargetStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum DeliveryAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum SocialProvider {
  FACEBOOK
  INSTAGRAM
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRING
  EXPIRED
  REAUTH_REQUIRED
  REVOKED
  DISCONNECTED
}

// How this account was linked: via a Facebook Page (Facebook Login for
// Business — also how a Page-linked Instagram professional account is
// discovered) or a standalone Instagram Login (no Facebook Page required).
// Sprint 07 needs this to pick the right token-refresh/API host per account.
enum SocialAccountAuthMethod {
  FACEBOOK_PAGE
  INSTAGRAM_LOGIN
}

enum OAuthTokenStatus {
  ACTIVE
  SUPERSEDED
  REVOKED
}

enum SocialPermissionStatus {
  GRANTED
  DECLINED
}

// Sprint 08 native states only: NEW (received), PROCESSED (resolved, either
// manually or via a sent reply), IGNORED, ESCALATED. Deliberately excludes
// the AI-pipeline states (ANALYZING/ANALYZED) and IN_PROGRESS from the sprint
// spec's own list — nothing in this sprint sets or reads them. Sprint 09 can
// extend this enum (ALTER TYPE ... ADD VALUE) once real analysis exists,
// rather than this sprint guessing at unused states now.
enum CommentStatus {
  NEW
  PROCESSED
  IGNORED
  ESCALATED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

// Taxonomie d'analyse du Sprint 09. Les valeurs sont celles du dataset annoté
// (services/ai-service/dataset/ANNOTATION_GUIDE.md) et du type `AiAnalysis`
// déjà défini côté mobile : une seule vocabulaire de bout en bout, pas de
// table de correspondance. Changer ces listes impose une nouvelle version du
// dataset ET une migration.
enum CommentSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum CommentIntent {
  QUESTION
  INFO_REQUEST
  COMPLAINT
  CLAIM
  OTHER
}

enum CommentPriority {
  LOW
  MEDIUM
  HIGH
}

// Cycle de vie d'une proposition de réponse (Sprint 10). Identique au type
// `ResponseStatus` du mobile. SENT n'est posé que lorsque graph-api confirme
// l'envoi réel chez Meta — jamais à l'approbation.
enum ResponseSuggestionStatus {
  PROPOSED
  EDITED
  APPROVED
  REJECTED
  SENT
  FAILED
}

enum ScheduleStatus {
  PENDING
  DISPATCHED
  CANCELLED
}

enum AiFormality {
  INFORMAL
  FORMAL
  ADAPTIVE
}

// Sprint 11. Vocabulaire du mobile depuis le Sprint 01 (voir
// social-media/src/types/index.ts::NotificationType) : une notification
// « commentaire reçu » générique n'existe pas côté écran — seuls les
// commentaires qui déclenchent réellement une catégorie (prioritaire, négatif,
// urgent) génèrent un push, pour ne pas alerter à chaque commentaire neutre.
enum NotificationType {
  PRIORITY_COMMENT
  NEGATIVE_COMMENT
  URGENT_COMMENT
  AI_RESPONSE_READY
  PUBLICATION_PUBLISHED
  PUBLICATION_FAILED
  PUBLICATION_PARTIAL
  TOKEN_EXPIRING
  TOKEN_EXPIRED
  SYNC_FAILED
  ACCOUNT_DISCONNECTED
}

// Distinct de CommentPriority : même échelle (LOW/MEDIUM/HIGH), mais un
// concept différent (urgence d'affichage de la notification, pas verdict
// d'analyse) — voir `Priority` côté mobile.
enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
}

// Ce que `resourceId` désigne, pour que le mobile sache quelle ressource
// recharger via l'API avant d'ouvrir l'écran (jamais le contenu du push).
enum NotificationResourceType {
  COMMENT
  PUBLICATION
  SOCIAL_ACCOUNT
}

enum DevicePlatform {
  ANDROID
  IOS
}

model User {
  id                      String                 @id @default(uuid()) @db.Uuid
  email                   String                 @unique @db.VarChar(320)
  passwordHash            String                 @map("password_hash")
  firstName               String                 @map("first_name") @db.VarChar(80)
  lastName                String                 @map("last_name") @db.VarChar(80)
  displayName             String                 @map("display_name") @db.VarChar(100)
  language                String                 @default("fr") @db.VarChar(8)
  timezone                String                 @default("Europe/Paris") @db.VarChar(64)
  phone                   String?                @db.VarChar(30)
  preferences             Json                   @default("{}")
  avatarMediaId           String?                @unique @map("avatar_media_id") @db.Uuid
  status                  UserStatus             @default(ACTIVE)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions                UserSession[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  memberships             BrandMember[]
  ownedBrands             Brand[]                @relation("BrandOwner")
  aiSettingsCreated       BrandAiSetting[]       @relation("AiSettingsAuthor")
  uploadedMedia           Media[]                @relation("MediaOwner")
  publications            Publication[]          @relation("PublicationAuthor")
  schedules               ScheduledPublication[] @relation("ScheduleAuthor")
  avatarMedia             Media?                 @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  connectedSocialAccounts SocialAccount[]        @relation("SocialAccountConnector")
  oauthStates             OAuthState[]
  commentStatusChanges    CommentStatusHistory[]
  sentResponses           SentResponse[]         @relation("SentResponseAuthor")
  commentAnalyses         CommentAnalysis[]      @relation("AnalysisRequester")
  responseSuggestions     ResponseSuggestion[]   @relation("SuggestionAuthor")
  approvedSuggestions     ResponseSuggestion[]   @relation("SuggestionApprover")
  notifications           Notification[]
  deviceTokens            DeviceToken[]
  notificationSettings    NotificationSetting?

  @@index([status])
  @@map("users")
}

model Brand {
  id              String           @id @default(uuid()) @db.Uuid
  ownerUserId     String           @map("owner_user_id") @db.Uuid
  name            String           @db.VarChar(120)
  description     String?          @db.Text
  industry        String?          @db.VarChar(100)
  primaryLanguage String           @default("fr") @map("primary_language") @db.VarChar(8)
  status          BrandStatus      @default(ACTIVE)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner           User             @relation("BrandOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members         BrandMember[]
  aiSettings      BrandAiSetting[]
  media           Media[]
  publications    Publication[]
  socialAccounts  SocialAccount[]
  oauthStates     OAuthState[]
  notifications   Notification[]

  @@index([ownerUserId])
  @@index([deletedAt])
  @@map("brands")
}

model BrandMember {
  id        String          @id @default(uuid()) @db.Uuid
  brandId   String          @map("brand_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  role      BrandMemberRole @default(VIEWER)
  isActive  Boolean         @default(false) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  brand     Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([brandId, userId])
  @@index([userId, isActive])
  @@index([brandId, role])
  @@map("brand_members")
}

model BrandAiSetting {
  id                    String      @id @default(uuid()) @db.Uuid
  brandId               String      @map("brand_id") @db.Uuid
  version               Int
  tone                  AiTone      @default(PROFESSIONAL)
  customTone            String?     @map("custom_tone") @db.Text
  formality             AiFormality @default(ADAPTIVE)
  language              String      @default("fr") @db.VarChar(8)
  emojisAllowed         Boolean     @default(true) @map("emojis_allowed")
  targetLength          String      @default("2 phrases") @map("target_length") @db.VarChar(32)
  greeting              String?     @db.VarChar(300)
  closing               String?     @db.VarChar(300)
  forbiddenTerms        Json        @default("[]") @map("forbidden_terms")
  recommendedTerms      Json        @default("[]") @map("recommended_terms")
  instructions          String?     @db.Text
  complaintInstructions String?     @map("complaint_instructions") @db.Text
  urgencyInstructions   String?     @map("urgency_instructions") @db.Text
  supportInstructions   String?     @map("support_instructions") @db.Text
  createdByUserId       String      @map("created_by_user_id") @db.Uuid
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  brand                 Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdByUser         User        @relation("AiSettingsAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([brandId, version])
  @@index([brandId, createdAt])
  @@map("brand_ai_settings")
}

model Media {
  id           String             @id @default(uuid()) @db.Uuid
  ownerUserId  String?            @map("owner_user_id") @db.Uuid
  brandId      String?            @map("brand_id") @db.Uuid
  bucket       String             @default("hootly") @db.VarChar(100)
  objectKey    String             @unique @map("object_key") @db.VarChar(1024)
  mimeType     String             @map("mime_type") @db.VarChar(127)
  sizeBytes    Int                @map("size_bytes")
  width        Int?
  height       Int?
  status       String             @default("READY") @db.VarChar(32)
  purpose      String             @default("publication") @db.VarChar(32)
  checksum     String?            @db.VarChar(128)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  owner        User?              @relation("MediaOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  brand        Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  avatarFor    User?              @relation("UserAvatar")
  publications PublicationMedia[]

  @@index([ownerUserId, createdAt])
  @@index([brandId, createdAt])
  @@map("media")
}

model UserSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  refreshTokenHash    String    @map("refresh_token_hash")
  deviceName          String    @default("Unknown device") @map("device_name") @db.VarChar(255)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt          DateTime? @map("last_used_at") @db.Timestamptz(6)
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String   @db.VarChar(120)
  resourceType String   @map("resource_type") @db.VarChar(80)
  resourceId   String?  @map("resource_id") @db.VarChar(255)
  requestId    String?  @map("request_id") @db.VarChar(100)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model Publication {
  id              String                @id @default(uuid()) @db.Uuid
  brandId         String                @map("brand_id") @db.Uuid
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  content         String                @db.Text
  language        String                @default("fr") @db.VarChar(8)
  hashtags        Json                  @default("[]")
  status          PublicationStatus     @default(DRAFT)
  scheduledAt     DateTime?             @map("scheduled_at") @db.Timestamptz(6)
  timezone        String                @default("Europe/Paris") @db.VarChar(64)
  publishedAt     DateTime?             @map("published_at") @db.Timestamptz(6)
  deletedAt       DateTime?             @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  brand           Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy       User                  @relation("PublicationAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  targets         PublicationTarget[]
  media           PublicationMedia[]
  schedule        ScheduledPublication?

  @@index([brandId, status])
  @@index([brandId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([deletedAt])
  // Sprint 12 : filtrage par période pour les agrégations analytics.
  @@index([brandId, publishedAt])
  @@map("publications")
}

model PublicationTarget {
  id                    String                       @id @default(uuid()) @db.Uuid
  publicationId         String                       @map("publication_id") @db.Uuid
  // Nullable for backward compatibility with rows created before Sprint 06
  // (no social_accounts yet). New writes should always set it once the
  // application-level check in publications/schemas.js requires it.
  socialAccountId       String?                      @map("social_account_id") @db.Uuid
  provider              SocialProvider
  adaptedContent        String?                      @map("adapted_content") @db.Text
  adaptedHashtags       Json                         @default("[]") @map("adapted_hashtags")
  status                PublicationTargetStatus      @default(PENDING)
  externalPublicationId String?                      @map("external_publication_id") @db.VarChar(255)
  lastErrorCode         String?                      @map("last_error_code") @db.VarChar(80)
  lastErrorMessage      String?                      @map("last_error_message") @db.Text
  attemptCount          Int                          @default(0) @map("attempt_count")
  sentAt                DateTime?                    @map("sent_at") @db.Timestamptz(6)
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  publication           Publication                  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  socialAccount         SocialAccount?               @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  attempts              PublicationDeliveryAttempt[]
  metrics               SocialMetric[]

  // Was @@unique([publicationId, provider]): structurally forbade two
  // accounts of the same provider on one publication. Sprint 06 replaces it
  // with a per-account constraint now that social_accounts exists.
  @@unique([publicationId, socialAccountId])
  @@index([publicationId, provider])
  @@index([status])
  // Sprint 12 : graph-api résout un publication_target_id à partir du couple
  // (social_account_id, external_publication_id) reçu de Meta.
  @@index([socialAccountId, externalPublicationId])
  @@map("publication_targets")
}

// Sprint 12. Historique append-only des relevés Meta pour une cible de
// publication : une ligne par tentative de synchronisation, jamais mise à
// jour ni dédupliquée, pour permettre les timelines et les deltas
// période-sur-période. Écrite uniquement par graph-api (raw SQL), même
// répartition que SocialComment/CommentAnalysis : Prisma possède le DDL,
// graph-api possède les écritures issues de Meta.
//
// null = Meta n'a pas renvoyé cette métrique pour cette tentative (permission
// manquante, type d'objet non supporté, erreur transitoire) : l'écran affiche
// « Non disponible » et ne doit jamais la traiter comme 0. 0 est une valeur
// que Meta a explicitement renvoyée.
model SocialMetric {
  id                  String            @id @default(uuid()) @db.Uuid
  publicationTargetId String            @map("publication_target_id") @db.Uuid
  collectedAt         DateTime          @map("collected_at") @db.Timestamptz(6)
  reactions           Int?
  comments            Int?
  shares              Int?
  reach               Int?
  impressions         Int?
  publicationTarget   PublicationTarget @relation(fields: [publicationTargetId], references: [id], onDelete: Cascade)

  @@index([publicationTargetId, collectedAt])
  @@map("social_metrics")
}

model PublicationMedia {
  id            String      @id @default(uuid()) @db.Uuid
  publicationId String      @map("publication_id") @db.Uuid
  mediaId       String      @map("media_id") @db.Uuid
  position      Int         @default(0)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  media         Media       @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([publicationId, mediaId])
  @@unique([publicationId, position])
  @@index([mediaId])
  @@map("publication_media")
}

model ScheduledPublication {
  id              String         @id @default(uuid()) @db.Uuid
  publicationId   String         @unique @map("publication_id") @db.Uuid
  scheduledAt     DateTime       @map("scheduled_at") @db.Timestamptz(6)
  timezone        String         @default("Europe/Paris") @db.VarChar(64)
  jobId           String?        @map("job_id") @db.VarChar(64)
  status          ScheduleStatus @default(PENDING)
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  publication     Publication    @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  createdBy       User           @relation("ScheduleAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([status, scheduledAt])
  @@map("scheduled_publications")
}

model PublicationDeliveryAttempt {
  id                    String                @id @default(uuid()) @db.Uuid
  publicationTargetId   String                @map("publication_target_id") @db.Uuid
  attemptNumber         Int                   @map("attempt_number")
  // Empêche qu'une même tentative parte deux fois, même si le job est rejoué.
  idempotencyKey        String                @unique @map("idempotency_key") @db.VarChar(200)
  status                DeliveryAttemptStatus @default(STARTED)
  errorCode             String?               @map("error_code") @db.VarChar(80)
  errorMessage          String?               @map("error_message") @db.Text
  externalPublicationId String?               @map("external_publication_id") @db.VarChar(255)
  startedAt             DateTime              @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt            DateTime?             @map("finished_at") @db.Timestamptz(6)
  target                PublicationTarget     @relation(fields: [publicationTargetId], references: [id], onDelete: Cascade)

  @@unique([publicationTargetId, attemptNumber], map: "publication_delivery_attempts_target_attempt_key")
  @@index([status, startedAt])
  @@map("publication_delivery_attempts")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @db.VarChar(200)
  endpoint       String   @db.VarChar(120)
  userId         String   @map("user_id") @db.Uuid
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  resourceId     String?  @map("resource_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// --- Sprint 06 : OAuth Meta, comptes sociaux multi-comptes, tokens chiffrés ---
//
// Ces tables sont migrées par Prisma (source de vérité du schéma, comme pour
// tout le reste du projet) mais sont lues/écrites en SQL brut par `graph-api`
// (Python, pas de client Prisma) — exactement le pattern déjà en place pour
// `services/worker`, qui lit/écrit `publications`/`publication_targets` via
// `pg` sans passer par ce client. Express ne doit jamais lire `oauth_tokens`
// directement : le texte est chiffré et la clé n'existe que côté graph-api.

model SocialAccount {
  id                 String                  @id @default(uuid()) @db.Uuid
  brandId            String                  @map("brand_id") @db.Uuid
  provider           SocialProvider
  externalAccountId  String                  @map("external_account_id") @db.VarChar(255)
  name               String                  @db.VarChar(255)
  username           String?                 @db.VarChar(255)
  avatarUrl          String?                 @map("avatar_url") @db.VarChar(1024)
  status             SocialAccountStatus     @default(CONNECTED)
  authMethod         SocialAccountAuthMethod @map("auth_method")
  connectedByUserId  String                  @map("connected_by_user_id") @db.Uuid
  lastCommentsSyncAt DateTime?               @map("last_comments_sync_at") @db.Timestamptz(6)
  lastMetricsSyncAt  DateTime?               @map("last_metrics_sync_at") @db.Timestamptz(6)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  brand              Brand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  connectedByUser    User                    @relation("SocialAccountConnector", fields: [connectedByUserId], references: [id], onDelete: Restrict)
  oauthTokens        OAuthToken[]
  permissions        SocialPermission[]
  publicationTargets PublicationTarget[]
  comments           SocialComment[]
  sentResponses      SentResponse[]

  // Un compte Meta donné (une Page, un compte IG) ne peut être lié qu'à une
  // seule marque à la fois — pas de constraint par brandId, volontairement.
  @@unique([provider, externalAccountId])
  @@index([brandId, status])
  @@map("social_accounts")
}

model OAuthToken {
  id                    String           @id @default(uuid()) @db.Uuid
  socialAccountId       String           @map("social_account_id") @db.Uuid
  // Jamais d'UPDATE en place : chaque rafraîchissement insère une nouvelle
  // ligne versionnée (comme BrandAiSetting), `status` marque laquelle est active.
  version               Int              @default(1)
  status                OAuthTokenStatus @default(ACTIVE)
  encryptedAccessToken  Bytes            @map("encrypted_access_token")
  encryptedRefreshToken Bytes?           @map("encrypted_refresh_token")
  encryptionKeyVersion  Int              @default(1) @map("encryption_key_version")
  scope                 Json             @default("[]")
  expiresAt             DateTime?        @map("expires_at") @db.Timestamptz(6)
  lastErrorCode         String?          @map("last_error_code") @db.VarChar(80)
  lastErrorMessage      String?          @map("last_error_message") @db.Text
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  socialAccount         SocialAccount    @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, version])
  @@index([socialAccountId, status])
  @@index([status, expiresAt])
  @@map("oauth_tokens")
}

model SocialPermission {
  id              String                 @id @default(uuid()) @db.Uuid
  socialAccountId String                 @map("social_account_id") @db.Uuid
  permission      String                 @db.VarChar(120)
  status          SocialPermissionStatus @default(GRANTED)
  checkedAt       DateTime               @default(now()) @map("checked_at") @db.Timestamptz(6)
  socialAccount   SocialAccount          @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, permission])
  @@map("social_permissions")
}

model OAuthState {
  id                String         @id @default(uuid()) @db.Uuid
  // Jamais le state en clair : seul son hash est stocké (même convention que
  // UserSession.refreshTokenHash / PasswordResetToken.tokenHash).
  stateHash         String         @unique @map("state_hash") @db.VarChar(128)
  userId            String         @map("user_id") @db.Uuid
  brandId           String         @map("brand_id") @db.Uuid
  provider          SocialProvider
  mobileRedirectUri String         @map("mobile_redirect_uri") @db.VarChar(2048)
  consumedAt        DateTime?      @map("consumed_at") @db.Timestamptz(6)
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand             Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_states")
}

// Idempotency-Key store for graph-api's own /internal/v1 routes (distinct
// from the Express-owned IdempotencyKey above, which has no service caller
// concept). Replaces the in-memory stopgap used in Sprint 05.
model ServiceIdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @db.VarChar(200)
  endpoint       String   @db.VarChar(120)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([endpoint, key])
  @@index([expiresAt])
  @@map("service_idempotency_keys")
}

// Sprint 08. Written only by graph-api (raw SQL, always sourced from Meta —
// same "Prisma owns DDL, graph-api owns writes" split as SocialAccount /
// OAuthToken). Express reads directly via Prisma (not secret, unlike
// oauth_tokens) and writes only `status` for local moderation actions.
model SocialComment {
  id                    String                 @id @default(uuid()) @db.Uuid
  socialAccountId       String                 @map("social_account_id") @db.Uuid
  externalCommentId     String                 @map("external_comment_id") @db.VarChar(255)
  externalPublicationId String?                @map("external_publication_id") @db.VarChar(255)
  authorExternalId      String?                @map("author_external_id") @db.VarChar(255)
  authorName            String?                @map("author_name") @db.VarChar(255)
  content               String?                @db.Text
  status                CommentStatus          @default(NEW)
  isDeletedOnPlatform   Boolean                @default(false) @map("is_deleted_on_platform")
  metaCreatedAt         DateTime?              @map("meta_created_at") @db.Timestamptz(6)
  metaUpdatedAt         DateTime?              @map("meta_updated_at") @db.Timestamptz(6)
  // Pointeur de cache vers la dernière ligne de `comment_analyses` (Sprint 09).
  // Aucune valeur d'analyse n'est recopiée ici : seule l'identité de la
  // dernière est dénormalisée, pour que filtrer une boîte de réception par
  // sentiment/priorité reste une jointure sur une ligne unique au lieu d'une
  // sous-requête « la plus récente par commentaire ». Écrit dans la MÊME
  // transaction que l'insertion de l'analyse — jamais séparément.
  latestAnalysisId      String?                @unique @map("latest_analysis_id") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  socialAccount         SocialAccount          @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  statusHistory         CommentStatusHistory[]
  sentResponse          SentResponse?
  suggestions           ResponseSuggestion[]
  analyses              CommentAnalysis[]      @relation("CommentAnalyses")
  latestAnalysis        CommentAnalysis?       @relation("LatestCommentAnalysis", fields: [latestAnalysisId], references: [id], onDelete: SetNull)

  // Clé d'upsert (webhook et synchronisation de secours) — dédup naturelle en
  // plus du hash de webhook_events.
  @@unique([socialAccountId, externalCommentId])
  @@index([socialAccountId, status])
  @@map("social_comments")
}

// Append-only : « réanalyser » crée une ligne, n'en modifie aucune. C'est ce
// qui permet à l'historique du commentaire d'afficher chaque passage du
// modèle (genre `ai_analysis`, prévu côté mobile depuis le Sprint 01 mais
// sans source jusqu'ici) et de savoir, après un réentraînement, quelle
// version du modèle avait produit un verdict donné.
//
// Deux écrivains, comme `PublicationTarget.status` : Express (action
// « Analyser » de l'écran commentaire) et le worker (passe automatique sur
// les commentaires reçus). Le service IA, lui, n'écrit jamais : il est sans
// état et ne connaît pas la base.
model CommentAnalysis {
  id                  String           @id @default(uuid()) @db.Uuid
  commentId           String           @map("comment_id") @db.Uuid
  sentiment           CommentSentiment
  intent              CommentIntent
  priority            CommentPriority
  confidence          Float
  sentimentConfidence Float            @map("sentiment_confidence")
  intentConfidence    Float            @map("intent_confidence")
  // Vrai quand une des deux tâches passe sous son seuil, ou quand le texte
  // n'est pas en français : l'écran doit pouvoir dire « à vérifier » plutôt
  // que d'afficher un verdict avec la même assurance que les autres.
  lowConfidence       Boolean          @default(false) @map("low_confidence")
  isUrgent            Boolean          @default(false) @map("is_urgent")
  isSensitive         Boolean          @default(false) @map("is_sensitive")
  language            String           @default("fr") @db.VarChar(8)
  recommendedAction   String           @map("recommended_action") @db.Text
  explanation         String           @db.Text
  // Signaux de règles déclenchés et termes les plus contributifs du modèle
  // linéaire : conservés pour pouvoir justifier une escalade a posteriori.
  signals             Json             @default("[]")
  topTerms            Json             @default("[]") @map("top_terms")
  modelVersion        String           @map("model_version") @db.VarChar(64)
  datasetVersion      String           @map("dataset_version") @db.VarChar(32)
  // Null quand l'analyse vient de la passe automatique du worker, renseigné
  // quand un community manager a cliqué « Analyser ».
  requestedByUserId   String?          @map("requested_by_user_id") @db.Uuid
  analysedAt          DateTime         @default(now()) @map("analysed_at") @db.Timestamptz(6)
  comment             SocialComment    @relation("CommentAnalyses", fields: [commentId], references: [id], onDelete: Cascade)
  requestedByUser     User?            @relation("AnalysisRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  latestForComment    SocialComment?   @relation("LatestCommentAnalysis")

  @@index([commentId, analysedAt])
  @@index([priority])
  @@index([sentiment])
  @@map("comment_analyses")
}

// Append-only, versionné par commentaire. Générer, modifier ou régénérer crée
// une ligne ; approuver ou rejeter met à jour la dernière. C'est ce qui répond
// à « conserver texte original et final » : `originalText` porte la
// proposition telle que l'IA l'a produite et n'est jamais réécrit, `text`
// porte la version courante.
//
// Pas de pointeur `latest_suggestion_id` sur social_comments, contrairement
// aux analyses : une proposition est seulement AFFICHÉE, jamais filtrée ni
// triée dessus. Une lecture groupée par page (même idiome que
// `resolvePublicationRefs`) suffit, et évite d'ajouter un second invariant à
// maintenir.
model ResponseSuggestion {
  id               String                   @id @default(uuid()) @db.Uuid
  commentId        String                   @map("comment_id") @db.Uuid
  version          Int
  text             String                   @db.Text
  originalText     String                   @map("original_text") @db.Text
  language         String                   @default("fr") @db.VarChar(8)
  tone             AiTone                   @default(PROFESSIONAL)
  status           ResponseSuggestionStatus @default(PROPOSED)
  // Faux dès qu'un humain a réécrit le texte : l'écran affiche « Généré par
  // l'IA » et cette mention doit cesser d'être vraie après une édition.
  generatedByAi    Boolean                  @default(true) @map("generated_by_ai")
  // « local-template-1.0.0 » ou « claude » : sans ça, impossible de savoir
  // après coup si une proposition venait du modèle ou du repli local.
  generator        String                   @db.VarChar(64)
  promptVersion    String                   @map("prompt_version") @db.VarChar(64)
  // Avertissements du contrôle de sécurité, tels qu'ils étaient au moment de
  // l'enregistrement — y compris ceux que le community manager a choisi
  // d'ignorer, ce qui est précisément ce qu'un audit veut pouvoir relire.
  warnings         Json                     @default("[]")
  blocked          Boolean                  @default(false)
  instruction      String?                  @db.Text
  createdByUserId  String                   @map("created_by_user_id") @db.Uuid
  approvedByUserId String?                  @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?                @map("approved_at") @db.Timestamptz(6)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  comment          SocialComment            @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdByUser    User                     @relation("SuggestionAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedByUser   User?                    @relation("SuggestionApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@unique([commentId, version])
  @@index([commentId, createdAt])
  @@index([status])
  @@map("response_suggestions")
}

// Append-only. Écrit par Express (actions manuelles : ignorer/escalader/
// marquer traité) et par graph-api (transition automatique vers PROCESSED
// quand une réponse part réellement).
model CommentStatusHistory {
  id              String         @id @default(uuid()) @db.Uuid
  commentId       String         @map("comment_id") @db.Uuid
  fromStatus      CommentStatus? @map("from_status")
  toStatus        CommentStatus  @map("to_status")
  // Null seulement en théorie (transition système sans utilisateur identifié) ;
  // dans ce sprint, toute transition a un utilisateur réel derrière elle.
  changedByUserId String?        @map("changed_by_user_id") @db.Uuid
  note            String?        @db.Text
  changedAt       DateTime       @default(now()) @map("changed_at") @db.Timestamptz(6)
  comment         SocialComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  changedByUser   User?          @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([commentId, changedAt])
  @@map("comment_status_history")
}

// Journal brut des livraisons webhook Meta — écrit uniquement par graph-api.
// Le hash est calculé par `change` individuel (pas par requête entière : Meta
// peut grouper plusieurs commentaires dans un seul POST), upsert de façon
// synchrone dans la requête avant toute BackgroundTask, pour que deux
// livraisons quasi simultanées du même événement ne passent pas toutes les
// deux la vérification de dédup avant qu'aucune ne l'ait enregistrée.
model WebhookEvent {
  id           String             @id @default(uuid()) @db.Uuid
  provider     SocialProvider
  payloadHash  String             @map("payload_hash") @db.VarChar(64)
  rawPayload   Json               @map("raw_payload")
  status       WebhookEventStatus @default(RECEIVED)
  errorMessage String?            @map("error_message") @db.Text
  receivedAt   DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt  DateTime?          @map("processed_at") @db.Timestamptz(6)

  @@unique([provider, payloadHash])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

// Une seule réponse valide par commentaire, jamais plus. La ligne est
// réclamée par `INSERT ... ON CONFLICT (comment_id) DO NOTHING` AVANT
// l'appel Meta (même idiome que PublicationDeliveryAttempt/CLAIM_TARGET) —
// garde-fou indépendant du cache de rejeu service_idempotency_keys, qui
// n'écrit qu'après coup et laisserait une fenêtre de double-envoi sans ça.
model SentResponse {
  id              String                @id @default(uuid()) @db.Uuid
  commentId       String                @unique @map("comment_id") @db.Uuid
  socialAccountId String                @map("social_account_id") @db.Uuid
  externalReplyId String?               @map("external_reply_id") @db.VarChar(255)
  content         String                @db.Text
  sentByUserId    String                @map("sent_by_user_id") @db.Uuid
  status          DeliveryAttemptStatus @default(STARTED)
  errorCode       String?               @map("error_code") @db.VarChar(80)
  errorMessage    String?               @map("error_message") @db.Text
  startedAt       DateTime              @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?             @map("finished_at") @db.Timestamptz(6)
  comment         SocialComment         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount         @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  sentByUser      User                  @relation("SentResponseAuthor", fields: [sentByUserId], references: [id], onDelete: Restrict)

  @@index([status, startedAt])
  @@map("sent_responses")
}

// Sprint 11. Une ligne par destinataire, jamais un événement métier partagé :
// un commentaire reçu sur une marque à trois community managers crée trois
// lignes (une par membre notifié), chacune avec son propre `readAt`.
// `eventId` porte l'identité de l'événement métier d'origine (ex. l'id de
// l'analyse, ou `publication:{id}:published`) — l'unicité est posée sur
// (eventId, userId), pas sur eventId seul, pour permettre exactement ce
// fan-out tout en rendant chaque envoi individuel idempotent (rejouer le même
// événement pour le même destinataire ne doit jamais créer de doublon).
//
// Persistée AVANT tout appel à Firebase (voir NotificationPushService) : un
// échec FCM ne doit jamais faire disparaître une ligne déjà écrite ici, qui
// reste la source de vérité pour l'historique et le compteur non lu.
model Notification {
  id           String                     @id @default(uuid()) @db.Uuid
  userId       String                     @map("user_id") @db.Uuid
  brandId      String?                    @map("brand_id") @db.Uuid
  type         NotificationType
  priority     NotificationPriority       @default(MEDIUM)
  title        String                     @db.VarChar(200)
  message      String                     @db.Text
  network      SocialProvider?
  resourceType NotificationResourceType?  @map("resource_type")
  resourceId   String?                    @map("resource_id") @db.Uuid
  // Identifiant de l'événement métier d'origine — permet à un producteur de
  // rejouer sans risque (ex. un sweep worker relancé après un crash) et sert
  // de clé de déduplication FCM (voir le payload logique du Jour 2).
  eventId      String                     @map("event_id") @db.VarChar(150)
  readAt       DateTime?                  @map("read_at") @db.Timestamptz(6)
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand        Brand?                     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// Sprint 11. Un utilisateur peut avoir plusieurs appareils actifs à la fois
// (téléphone + tablette) : chaque token FCM est sa propre ligne, jamais
// remplacée par la précédente. `token` est unique globalement — un même
// device réinstallé/reconnecté sous un autre compte réassigne la ligne au
// nouvel utilisateur plutôt que d'en créer une deuxième orpheline.
// `disabledAt` marque un token que FCM a signalé invalide/non enregistré
// (voir NotificationPushService) sans perdre l'historique de l'appareil ;
// DELETE /device-tokens (déconnexion volontaire) supprime la ligne pour de
// bon, ce sont deux gestes différents.
model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  token      String         @unique @db.VarChar(400)
  platform   DevicePlatform
  disabledAt DateTime?      @map("disabled_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// Sprint 11. Une ligne par utilisateur, créée à la demande (voir
// notifications/service.js::getNotificationSettings) plutôt qu'à
// l'inscription : un utilisateur qui n'a jamais rien réglé lit des valeurs
// par défaut sans qu'une ligne existe, exactement comme
// profile/service.js::preferencesOf pour les préférences générales. Une
// PATCH crée la ligne au besoin (upsert).
model NotificationSetting {
  userId               String               @id @map("user_id") @db.Uuid
  negativeComment      Boolean              @default(true) @map("negative_comment")
  urgentComment        Boolean              @default(true) @map("urgent_comment")
  highPriorityComment  Boolean              @default(true) @map("high_priority_comment")
  aiResponseGenerated  Boolean              @default(true) @map("ai_response_generated")
  publicationPublished Boolean              @default(true) @map("publication_published")
  publicationFailed    Boolean              @default(true) @map("publication_failed")
  tokenExpiring        Boolean              @default(true) @map("token_expiring")
  syncFailed           Boolean              @default(true) @map("sync_failed")
  sound                Boolean              @default(true)
  vibration            Boolean              @default(true)
  // "HH:mm", nulles ensemble tant que l'utilisateur n'a rien réglé : pas de
  // plage silencieuse par défaut plutôt qu'une plage arbitraire imposée.
  quietHoursStart      String?              @map("quiet_hours_start") @db.VarChar(5)
  quietHoursEnd        String?              @map("quiet_hours_end") @db.VarChar(5)
  minimumPriority      NotificationPriority @default(LOW) @map("minimum_priority")
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}
